<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.cpressland.JurassicParkOperationGenesis</id>
  <name>Jurassic Park: Operation Genesis</name>
  <summary>Blue Tongue's 2003 dinosaur park builder, recompiled to run natively</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.cpressland">
    <name>Chris Pressland</name>
  </developer>
  <description>
    <p>
      A static recompilation of Jurassic Park: Operation Genesis: the original
      game's code translated to C and compiled for this computer, with Windows'
      and Direct3D 8's parts answered natively on Vulkan. No emulator, no Wine.
    </p>
    <p>
      The first time it runs, it downloads the game's disc image and builds the
      game from it, which takes 10 to 20 minutes.
    </p>
  </description>
  <launchable type="desktop-id">io.cpressland.JurassicParkOperationGenesis.desktop</launchable>
  <url type="homepage">https://github.com/cpressland/jpog-recomp</url>
  <url type="bugtracker">https://github.com/cpressland/jpog-recomp/issues</url>
  <url type="vcs-browser">https://github.com/cpressland/jpog-recomp</url>
  <!-- The launcher's own screens only: the game's are Universal's art. -->
  <screenshots>
    <screenshot type="default">
      <caption>The first run downloads the game and builds it</caption>
      <image>https://raw.githubusercontent.com/cpressland/jpog-recomp/main/app/linux/screenshots/setup.png</image>
    </screenshot>
    <screenshot>
      <caption>Building the game on this computer</caption>
      <image>https://raw.githubusercontent.com/cpressland/jpog-recomp/main/app/linux/screenshots/building.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#b86b18</color>
    <color type="primary" scheme_preference="dark">#1e482c</color>
  </branding>
  <content_rating type="oars-1.1"/>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>gamepad</control>
  </supports>
  <releases>
    <release version="{version}" date="{date}"/>
  </releases>
</component>
