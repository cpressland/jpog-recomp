#!/bin/sh
# The AppImage's entry: Jurassic Park: Operation Genesis's launcher
# (launcher.c) with the build tools the AppImage carries (build-appimage.sh),
# so the player's computer needs no compiler of its own, as on a Steam Deck.
#
# The AppImage mounts somewhere new each run, and the game's build (CMake's
# cache, the game's rpath to SDL and shaderc) must not depend on where. So
# the game folder gets a link, appimage/, to this run's mount, and everything
# names that.
#
#   Jurassic-Park-Operation-Genesis-x86_64.AppImage [game arguments]
#   Jurassic-Park-Operation-Genesis-x86_64.AppImage --install [install.py arguments]
#       the build without a window: --status, --download, or --iso for your own
#
# JPOG_HOME: the game, its build and logs ($XDG_DATA_HOME/jurassic-park-operation-genesis).
set -e
here=$(dirname "$(readlink -f "$0")")
home=${JPOG_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/jurassic-park-operation-genesis}
mkdir -p "$home"
ln -sfn "$here" "$home/appimage"
t=$home/appimage/usr

# CMake records its own real path in the build (to re-run itself), and here
# that is inside this run's mount, gone by the next. So the build uses a copy
# in the game folder, one per CMake version.
cmake_dir=$home/tools/cmake-$(cat "$here/usr/cmake/VERSION")
if [ ! -x "$cmake_dir/bin/cmake" ]; then
  mkdir -p "$home/tools"
  rm -rf "$cmake_dir.part"
  cp -R "$here/usr/cmake" "$cmake_dir.part" && mv "$cmake_dir.part" "$cmake_dir"
  for old in "$home"/tools/cmake-*; do [ "$old" = "$cmake_dir" ] || rm -rf "$old"; done
fi
export JPOG_CMAKE="$cmake_dir/bin/cmake"

export JPOG_HOME="$home"
export JPOG_SHARE="$t/share/jurassic-park-operation-genesis"
export JPOG_PYTHON="$t/python/bin/python3"
export JPOG_FONTS="$t/share/fonts"
export JPOG_FFMPEG="$t/ffmpeg"
export JPOG_VORBIS="$t/vorbis"
export PATH="$t/bin:$PATH"
export CC="$t/bin/cc"
export PKG_CONFIG_PATH="$t/lib/pkgconfig" PKG_CONFIG_LIBDIR="$t/lib/pkgconfig"
export LDFLAGS="-Wl,-rpath,$t/lib"      # the game finds the AppImage's SDL and shaderc
# zig finds its libc headers from its own real path (this mount), and the
# build's dependency records would name them there: an update would then
# compile everything again. Through the link instead.
export ZIG_LIB_DIR="$t/zig/lib"
export ZIG_GLOBAL_CACHE_DIR="$home/build/zig-cache"
export ZIG_LOCAL_CACHE_DIR="$home/build/zig-cache"

if [ "${1:-}" = --install ]; then
  shift
  exec "$JPOG_PYTHON" -I "$JPOG_SHARE/src/jpog/tools/install/install.py" \
    --dest "$home" --pcrecomp "$JPOG_SHARE/src/pcrecomp" \
    --ffmpeg "$JPOG_FFMPEG" --vorbis "$JPOG_VORBIS" "$@"
fi
exec "$t/bin/jurassic-park-operation-genesis" "$@"
